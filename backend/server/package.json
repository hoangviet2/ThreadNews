{
  "name": "@threadnews/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/dev.ts",
    "build": "node scripts/build.mjs",
    "seed": "node scripts/seed.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "deploy": "node scripts/build-functions.mjs && cd ../.. && npx -y firebase-tools@latest deploy --only functions:api --project threadnews-4c8bd --non-interactive",
    "build:functions": "node scripts/build-functions.mjs",
    "deploy:vercel": "node scripts/build.mjs && npx -y vercel@latest deploy --prebuilt --prod --yes"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@hono/node-server": "^2.1.11",
    "@threadnews/graph": "workspace:*",
    "@threadnews/shared": "workspace:*",
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0",
    "hono": "^4.13.21",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
