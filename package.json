{
  "name": "threadnews",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @threadnews/website dev",
    "dev:ext": "pnpm --filter @threadnews/extension dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev:api": "pnpm --filter @threadnews/server dev",
    "emulators": "npx -y firebase-tools@latest emulators:start --only auth,firestore --project demo-threadnews",
    "test:rules": "pnpm --filter @threadnews/database test:rules",
    "test:emulator": "pnpm --filter @threadnews/graph test:emulator",
    "seed": "pnpm --filter @threadnews/server seed",
    "deploy:api": "pnpm --filter @threadnews/server run deploy"
  }
}
