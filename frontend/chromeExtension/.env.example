# Firebase web config (public by design). Leave empty to run in demo mode with sample stories.
WXT_FIREBASE_API_KEY=
WXT_FIREBASE_AUTH_DOMAIN=
WXT_FIREBASE_PROJECT_ID=
WXT_FIREBASE_APP_ID=
# ThreadNews API. Leave empty to use the in-browser demo API (sample stories only).
WXT_API_BASE_URL=
# Where "Open full explainer" links go.
WXT_WEBSITE_URL=http://localhost:5173
# Judge build only — never commit. Revoke after Dec 16.
WXT_APPCHECK_DEBUG_TOKEN=
# Chrome Extension OAuth client (Google Cloud console) for Google sign-in.
WXT_OAUTH_CLIENT_ID=
# Base64 public key → stable extension ID (OAuth client + Firebase authorized domain depend on it).
WXT_EXTENSION_KEY=
