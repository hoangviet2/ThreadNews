# Firebase web config (public by design). Leave empty to run in demo mode with sample stories.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# App Check: set ONE of these (site keys are public). The console has a reCAPTCHA Enterprise key registered.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
VITE_RECAPTCHA_V3_SITE_KEY=
# Local dev only (never in a deployed build, never commit): App Check debug token from the console.
VITE_APPCHECK_DEBUG_TOKEN=
# ThreadNews API. Leave empty to use the in-browser demo API (sample stories only).
VITE_API_BASE_URL=
VITE_USE_EMULATORS=false
